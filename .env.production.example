# Copy to .env.production (gitignored) and fill in real values before
# deploying via docker-compose.dokploy.yml. Variable names here match what
# apps/api/src/env.ts actually reads — some differ from generic naming
# conventions (JWT_SECRET, APP_SECRET, etc.) because they were established
# earlier in this codebase; see the inline note on each one.

# --- Database ---------------------------------------------------------------
# docker-compose.dokploy.yml builds DATABASE_URL from these three itself
# (postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB);
# you don't set DATABASE_URL directly in production. Generate a real
# password with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_USER=sordi
POSTGRES_PASSWORD=change-me-to-a-real-random-secret
POSTGRES_DB=sordi

# --- Session / auth tokens ---------------------------------------------------
# The desktop licensing flow does NOT use these — they're for the separate
# web-SaaS login system (apps/api/src/routes/auth.ts). Generate real values
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-real-random-secret
JWT_REFRESH_SECRET=change-me-to-a-real-random-secret

# --- Desktop license signing (this IS the "APP_SECRET / LICENSE_SIGNING_KEY"
# concept) ---------------------------------------------------------------
# Ed25519 keypair — the PRIVATE half lives only here; the matching PUBLIC
# half is compiled into apps/desktop/src-tauri/src/license.rs. Generate with:
#   node -e "const c=require('crypto');const {privateKey}=c.generateKeyPairSync('ed25519');console.log(JSON.stringify(privateKey.export({type:'pkcs8',format:'pem'})))"
# NEVER reuse the repo's existing dev/test keypair in production — see
# LICENSING.md. Rotating this after real licenses exist invalidates every
# license already issued with the old key.
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Shared secret for the manual admin endpoints (issue a license, list
# devices/leads) — apps/admin's login screen. Generate with the same
# randomBytes command as above.
LICENSE_ADMIN_SECRET=change-me-to-a-real-random-secret

# --- Lead-download email alerts (optional — no-ops if unset) ---------------
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# --- Landing page download targets ------------------------------------------
# Point these at your real hosted .dmg/.exe once you have them (e.g. a
# GitHub Releases asset URL or an object-storage URL) — the placeholder
# paths below 404 on their own until real files are hosted at them.
DOWNLOAD_URL_MACOS=/downloads/sordi-finance-mac.dmg
DOWNLOAD_URL_WINDOWS=/downloads/sordi-finance-windows.exe

# --- Public URLs --------------------------------------------------------
# PUBLIC_WEB_URL feeds the api service's CORS_ORIGIN (see
# docker-compose.dokploy.yml); PUBLIC_API_URL is baked into the web build as
# VITE_API_URL at Docker build time — changing it requires rebuilding the
# web image, not just restarting the container.
PUBLIC_WEB_URL=https://sordi.finance
PUBLIC_API_URL=https://api.sordi.finance
