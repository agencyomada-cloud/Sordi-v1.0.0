# Copy to .env for local development (apps/api/.env is gitignored by the root .gitignore).

# Local Postgres started by `docker compose up` in this directory.
DATABASE_URL=postgres://sordi:sordi_dev_password@localhost:5434/sordi

# Generate real random secrets for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

PORT=4000

# Origin(s) allowed to call this API with credentials (comma-separated).
CORS_ORIGIN=http://localhost:5173
