# Copy to .env for local development (apps/api/.env is gitignored by the root .gitignore).

# Local Postgres started by `docker compose up` in this directory.
DATABASE_URL=postgres://sordi:sordi_dev_password@localhost:5434/sordi

# Generate real random secrets for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

PORT=4000

# Origin(s) allowed to call this API with credentials (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Ed25519 keypair for signing license tokens (see LICENSING.md). Generate
# with: node -e "const c=require('crypto');const {privateKey}=c.generateKeyPairSync('ed25519');console.log(JSON.stringify(privateKey.export({type:'pkcs8',format:'pem'})))"
# Paste the private key here; embed the PUBLIC key in
# apps/desktop/src-tauri/src/license.rs (instructions in LICENSING.md).
# Never reuse a keypair across environments once real licenses exist.
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_ADMIN_SECRET=dev-only-license-admin-secret-change-me
