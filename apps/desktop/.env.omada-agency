# omada-agency branch only. Loaded when vite runs with --mode omada-agency
# (this branch's dev/build scripts set that by default — see package.json).
# Not a secret: just flips useLicenseStatus() (src/hooks/useLicense.ts) to
# always report an active license, so this white-label edition never shows
# license/upgrade UI. The real Sordi licensing code is untouched by this —
# see PROJECT_STATE.md for the full mechanism.
VITE_LICENSE_BYPASS=true
