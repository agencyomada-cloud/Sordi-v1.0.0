{
  "name": "sordi",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @sordi/desktop dev",
    "build": "pnpm --filter @sordi/desktop build",
    "build:dev": "pnpm --filter @sordi/desktop build:dev",
    "lint": "pnpm --filter @sordi/desktop lint",
    "preview": "pnpm --filter @sordi/desktop preview",
